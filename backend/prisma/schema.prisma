generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Farmer {
  id          Int      @id @default(autoincrement())
  farmerCode  String   @unique @map("farmer_code") @db.VarChar(20)
  fullName    String   @map("full_name") @db.VarChar(100)
  nationalId  String?  @unique @map("national_id") @db.VarChar(13)
  phone       String?  @db.VarChar(20)
  address     String?
  province    String?  @db.VarChar(60)
  district    String?  @db.VarChar(60)
  subdistrict String?  @db.VarChar(60)
  bankAccount String?  @map("bank_account") @db.VarChar(20)
  bankName    String?  @map("bank_name") @db.VarChar(60)
  bankBranch  String?  @map("bank_branch") @db.VarChar(100)
  lineId      String?  @map("line_id") @db.VarChar(60)
  isActive    Boolean  @default(true) @map("is_active")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  farmPlots   FarmPlot[]
  weighTickets WeighTicket[]

  @@map("farmers")
}

model FarmPlot {
  id           Int      @id @default(autoincrement())
  farmerId     Int      @map("farmer_id")
  plotCode     String   @unique @map("plot_code") @db.VarChar(30)
  titleDeedNo  String?  @map("title_deed_no") @db.VarChar(50)
  areaRai      Decimal? @map("area_rai") @db.Decimal(10, 2)
  province     String?  @db.VarChar(60)
  district     String?  @db.VarChar(60)
  subdistrict  String?  @db.VarChar(60)
  gpsLat       Decimal? @map("gps_lat") @db.Decimal(10, 7)
  gpsLng       Decimal? @map("gps_lng") @db.Decimal(10, 7)
  palmAgeYears Int?     @map("palm_age_years")
  note         String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  farmer       Farmer   @relation(fields: [farmerId], references: [id])
  weighTickets WeighTicket[]

  @@index([farmerId], map: "idx_farm_plots_farmer_id")
  @@map("farm_plots")
}

model Vehicle {
  id              Int      @id @default(autoincrement())
  licensePlate    String   @unique @map("license_plate") @db.VarChar(20)
  vehicleType     String?  @map("vehicle_type") @db.VarChar(50)
  brand           String?  @db.VarChar(50)
  tareWeightKg    Decimal  @default(0) @map("tare_weight_kg") @db.Decimal(10, 2)
  driverName      String?  @map("driver_name") @db.VarChar(100)
  driverPhone     String?  @map("driver_phone") @db.VarChar(20)
  driverLicenseNo String?  @map("driver_license_no") @db.VarChar(30)
  isActive        Boolean  @default(true) @map("is_active")
  note            String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  weighTickets    WeighTicket[]

  @@map("vehicles")
}

model DailyPrice {
  id              Int      @id @default(autoincrement())
  priceDate       DateTime @unique @map("price_date") @db.Date
  priceGradeA     Decimal  @map("price_grade_a") @db.Decimal(8, 2)
  priceGradeB     Decimal  @map("price_grade_b") @db.Decimal(8, 2)
  priceGradeC     Decimal  @map("price_grade_c") @db.Decimal(8, 2)
  ffaThresholdA   Decimal  @default(5.00) @map("ffa_threshold_a") @db.Decimal(5, 2)
  ffaThresholdB   Decimal  @default(7.00) @map("ffa_threshold_b") @db.Decimal(5, 2)
  referenceSource String?  @default("MPOB") @map("reference_source") @db.VarChar(60)
  note            String?
  createdBy       String?  @map("created_by") @db.VarChar(60)
  branchId        Int      @map("branch_id")
  branch          Branch   @relation(fields: [branchId], references: [id])

  weighTickets    WeighTicket[]

  @@unique([priceDate, branchId])
  @@index([priceDate(sort: Desc)], map: "idx_daily_prices_date")
  @@index([branchId], map: "idx_daily_prices_branch_id")
  @@map("daily_prices")
}

model WeighTicket {
  id              Int          @id @default(autoincrement())
  ticketNo        String       @unique @map("ticket_no") @db.VarChar(20)
  farmerId        Int          @map("farmer_id")
  vehicleId       Int?         @map("vehicle_id")
  priceId         Int          @map("price_id")
  farmPlotId      Int?         @map("farm_plot_id")
  weighInAt       DateTime     @default(now()) @map("weigh_in_at") @db.Timestamptz(6)
  weighOutAt      DateTime?    @map("weigh_out_at") @db.Timestamptz(6)
  grossWeightKg   Decimal      @map("gross_weight_kg") @db.Decimal(10, 2)
  tareWeightKg    Decimal      @map("tare_weight_kg") @db.Decimal(10, 2)
  netWeightKg     Decimal?     @map("net_weight_kg") @db.Decimal(10, 2)
  ffaPercent      Decimal?     @map("ffa_percent") @db.Decimal(5, 2)
  oilPercent      Decimal?     @map("oil_percent") @db.Decimal(5, 2)
  moisturePercent Decimal?     @map("moisture_percent") @db.Decimal(5, 2)
  grade           PalmGrade    @default(A)
  deductionKg     Decimal      @default(0) @map("deduction_kg") @db.Decimal(10, 2)
  deductionNote   String?      @map("deduction_note") @db.VarChar(200)
  finalWeightKg   Decimal?     @map("final_weight_kg") @db.Decimal(10, 2)
  pricePerKg      Decimal      @map("price_per_kg") @db.Decimal(8, 2)
  totalAmount     Decimal?     @map("total_amount") @db.Decimal(12, 2)
  status          TicketStatus @default(draft)
  photoUrls       String[]     @map("photo_urls")
  note            String?
  createdBy       String?      @map("created_by") @db.VarChar(60)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  branchId        Int          @map("branch_id")

  farmer          Farmer       @relation(fields: [farmerId], references: [id])
  vehicle         Vehicle?     @relation(fields: [vehicleId], references: [id])
  price           DailyPrice   @relation(fields: [priceId], references: [id])
  farmPlot        FarmPlot?    @relation(fields: [farmPlotId], references: [id])
  branch          Branch       @relation(fields: [branchId], references: [id])

  @@index([farmerId], map: "idx_tickets_farmer_id")
  @@index([grade], map: "idx_tickets_grade")
  @@index([priceId], map: "idx_tickets_price_id")
  @@index([status], map: "idx_tickets_status")
  @@index([vehicleId], map: "idx_tickets_vehicle_id")
  @@index([branchId], map: "idx_tickets_branch_id")
  @@index([weighInAt(sort: Desc)], map: "idx_tickets_weigh_in_at")
  @@map("weigh_tickets")
}

model Payment {
  id          Int           @id @default(autoincrement())
  paymentRef  String        @unique @map("payment_ref") @db.VarChar(30)
  farmerId    Int           @map("farmer_id")
  paymentDate DateTime      @default(now()) @map("payment_date") @db.Date
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod @default(bank_transfer)
  bankRef     String?       @map("bank_ref") @db.VarChar(60)
  status      PaymentStatus @default(pending)
  note        String?
  createdBy   String?       @map("created_by") @db.VarChar(60)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  branchId    Int           @map("branch_id")

  branch      Branch        @relation(fields: [branchId], references: [id])

  @@index([paymentDate(sort: Desc)], map: "idx_payments_date")
  @@index([farmerId], map: "idx_payments_farmer_id")
  @@index([status], map: "idx_payments_status")
  @@index([branchId], map: "idx_payments_branch_id")
  @@map("payments")
}

model PaymentItem {
  id        Int     @id @default(autoincrement())
  paymentId Int     @map("payment_id")
  ticketId  Int     @unique @map("ticket_id")
  amount    Decimal @db.Decimal(12, 2)

  @@index([paymentId], map: "idx_payment_items_payment")
  @@index([ticketId], map: "idx_payment_items_ticket")
  @@map("payment_items")
}

model Deduction {
  id               Int           @id @default(autoincrement())
  farmerId         Int           @map("farmer_id")
  deductionType    DeductionType @default(other) @map("deduction_type")
  description      String        @db.VarChar(200)
  amount           Decimal       @db.Decimal(12, 2)
  deductionDate    DateTime      @default(now()) @map("deduction_date") @db.Date
  isSettled        Boolean       @default(false) @map("is_settled")
  settledPaymentId Int?          @map("settled_payment_id")
  createdBy        String?       @map("created_by") @db.VarChar(60)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  branchId         Int           @map("branch_id")

  branch           Branch        @relation(fields: [branchId], references: [id])

  @@index([farmerId], map: "idx_deductions_farmer_id")
  @@index([isSettled], map: "idx_deductions_settled")
  @@index([branchId], map: "idx_deductions_branch_id")
  @@map("deductions")
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique @db.VarChar(60)
  fullName     String    @map("full_name") @db.VarChar(100)
  email        String?   @unique @db.VarChar(120)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         UserRole  @default(viewer)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  branchId     Int?      @map("branch_id")

  branch       Branch?   @relation(fields: [branchId], references: [id])

  @@map("users")
}

model Branch {
  id          Int      @id @default(autoincrement())
  branchCode  String   @unique @map("branch_code") @db.VarChar(20)
  branchName  String   @map("branch_name") @db.VarChar(100)
  address     String?
  phone       String?  @db.VarChar(20)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  weighTickets WeighTicket[]
  users        User[]
  stocks       Stock[]
  payments     Payment[]
  deductions   Deduction[]
  sales        Sale[]
  prices       DailyPrice[]

  @@map("branches")
}

model Stock {
  id          Int       @id @default(autoincrement())
  branchId    Int       @map("branch_id")
  grade       PalmGrade
  quantityKg  Decimal   @default(0) @map("quantity_kg") @db.Decimal(12, 2)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch      Branch    @relation(fields: [branchId], references: [id])

  @@unique([branchId, grade])
  @@map("stocks")
}

model Sale {
  id              Int          @id @default(autoincrement())
  saleNo          String       @unique @map("sale_no") @db.VarChar(20)
  branchId        Int          @map("branch_id")
  customerName    String?      @map("customer_name") @db.VarChar(100)
  saleDate        DateTime     @default(now()) @map("sale_date") @db.Timestamptz(6)
  grade           PalmGrade
  quantityKg      Decimal      @map("quantity_kg") @db.Decimal(12, 2)
  pricePerKg      Decimal      @map("price_per_kg") @db.Decimal(8, 2)
  totalAmount     Decimal?     @map("total_amount") @db.Decimal(12, 2)
  note            String?
  status          SaleStatus   @default(completed)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch          Branch       @relation(fields: [branchId], references: [id])

  @@index([branchId], map: "idx_sales_branch_id")
  @@index([saleDate], map: "idx_sales_date")
  @@map("sales")
}

enum PalmGrade {
  A
  B
  C

  @@map("palm_grade")
}

enum TicketStatus {
  draft
  confirmed
  paid
  cancelled

  @@map("ticket_status")
}

enum PaymentMethod {
  bank_transfer
  cash
  cheque

  @@map("payment_method")
}

enum PaymentStatus {
  pending
  completed
  cancelled

  @@map("payment_status")
}

enum DeductionType {
  loan
  input_cost
  transport
  other

  @@map("deduction_type")
}

enum UserRole {
  admin
  weigher
  accountant
  viewer

  @@map("user_role")
}

enum SaleStatus {
  completed
  cancelled

  @@map("sale_status")
}
