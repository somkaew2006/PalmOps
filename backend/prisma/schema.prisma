generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id            Int            @id @default(autoincrement())
  name          String         @db.VarChar(100)
  subdomain     String         @unique @db.VarChar(50)
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  branches      Branch[]
  customers     Customer[]
  farmers       Farmer[]
  productGroups ProductGroup[]
  users         User[]
  vehicles      Vehicle[]

  @@map("companies")
}

model Farmer {
  id           Int           @id @default(autoincrement())
  companyId    Int           @map("company_id")
  farmerCode   String        @map("farmer_code") @db.VarChar(20)
  fullName     String        @map("full_name") @db.VarChar(100)
  nationalId   String?       @map("national_id") @db.VarChar(13)
  phone        String?       @db.VarChar(20)
  address      String?
  province     String?       @db.VarChar(60)
  district     String?       @db.VarChar(60)
  subdistrict  String?       @db.VarChar(60)
  bankAccount  String?       @map("bank_account") @db.VarChar(20)
  bankName     String?       @map("bank_name") @db.VarChar(60)
  bankBranch   String?       @map("bank_branch") @db.VarChar(100)
  lineId       String?       @map("line_id") @db.VarChar(60)
  isActive     Boolean       @default(true) @map("is_active")
  note         String?
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  farmPlots    FarmPlot[]
  company      Company       @relation(fields: [companyId], references: [id])
  weighTickets WeighTicket[]

  @@unique([companyId, farmerCode])
  @@unique([companyId, nationalId])
  @@index([companyId], map: "idx_farmers_company_id")
  @@map("farmers")
}

model FarmPlot {
  id           Int           @id @default(autoincrement())
  companyId    Int           @map("company_id")
  farmerId     Int           @map("farmer_id")
  plotCode     String        @map("plot_code") @db.VarChar(30)
  titleDeedNo  String?       @map("title_deed_no") @db.VarChar(50)
  areaRai      Decimal?      @map("area_rai") @db.Decimal(10, 2)
  province     String?       @db.VarChar(60)
  district     String?       @db.VarChar(60)
  subdistrict  String?       @db.VarChar(60)
  gpsLat       Decimal?      @map("gps_lat") @db.Decimal(10, 7)
  gpsLng       Decimal?      @map("gps_lng") @db.Decimal(10, 7)
  palmAgeYears Int?          @map("palm_age_years")
  note         String?
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  farmer       Farmer        @relation(fields: [farmerId], references: [id])
  weighTickets WeighTicket[]

  @@unique([companyId, plotCode])
  @@index([companyId], map: "idx_farm_plots_company_id")
  @@index([farmerId], map: "idx_farm_plots_farmer_id")
  @@map("farm_plots")
}

model Vehicle {
  id              Int           @id @default(autoincrement())
  companyId       Int           @map("company_id")
  licensePlate    String        @map("license_plate") @db.VarChar(20)
  vehicleType     String?       @map("vehicle_type") @db.VarChar(50)
  brand           String?       @db.VarChar(50)
  tareWeightKg    Decimal       @default(0) @map("tare_weight_kg") @db.Decimal(10, 2)
  driverName      String?       @map("driver_name") @db.VarChar(100)
  driverPhone     String?       @map("driver_phone") @db.VarChar(20)
  driverLicenseNo String?       @map("driver_license_no") @db.VarChar(30)
  isActive        Boolean       @default(true) @map("is_active")
  note            String?
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  company         Company       @relation(fields: [companyId], references: [id])
  weighTickets    WeighTicket[]

  @@unique([companyId, licensePlate])
  @@index([companyId], map: "idx_vehicles_company_id")
  @@map("vehicles")
}

model DailyPrice {
  id              Int           @id @default(autoincrement())
  companyId       Int           @map("company_id")
  priceDate       DateTime      @map("price_date") @db.Date
  priceGradeA     Decimal       @map("price_grade_a") @db.Decimal(8, 2)
  priceGradeB     Decimal       @map("price_grade_b") @db.Decimal(8, 2)
  priceGradeC     Decimal       @map("price_grade_c") @db.Decimal(8, 2)
  ffaThresholdA   Decimal       @default(5.00) @map("ffa_threshold_a") @db.Decimal(5, 2)
  ffaThresholdB   Decimal       @default(7.00) @map("ffa_threshold_b") @db.Decimal(5, 2)
  referenceSource String?       @default("MPOB") @map("reference_source") @db.VarChar(60)
  note            String?
  createdBy       String?       @map("created_by") @db.VarChar(60)
  branchId        Int           @map("branch_id")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  branch          Branch        @relation(fields: [branchId], references: [id])
  weighTickets    WeighTicket[]

  @@unique([companyId, priceDate, branchId])
  @@index([companyId], map: "idx_daily_prices_company_id")
  @@index([priceDate(sort: Desc)], map: "idx_daily_prices_date")
  @@index([branchId], map: "idx_daily_prices_branch_id")
  @@map("daily_prices")
}

model WeighTicket {
  id              Int          @id @default(autoincrement())
  companyId       Int          @map("company_id")
  ticketNo        String       @map("ticket_no") @db.VarChar(20)
  farmerId        Int          @map("farmer_id")
  vehicleId       Int?         @map("vehicle_id")
  priceId         Int          @map("price_id")
  farmPlotId      Int?         @map("farm_plot_id")
  weighInAt       DateTime     @default(now()) @map("weigh_in_at") @db.Timestamptz(6)
  weighOutAt      DateTime?    @map("weigh_out_at") @db.Timestamptz(6)
  grossWeightKg   Decimal      @map("gross_weight_kg") @db.Decimal(10, 2)
  tareWeightKg    Decimal      @map("tare_weight_kg") @db.Decimal(10, 2)
  netWeightKg     Decimal?     @map("net_weight_kg") @db.Decimal(10, 2)
  ffaPercent      Decimal?     @map("ffa_percent") @db.Decimal(5, 2)
  oilPercent      Decimal?     @map("oil_percent") @db.Decimal(5, 2)
  moisturePercent Decimal?     @map("moisture_percent") @db.Decimal(5, 2)
  grade           PalmGrade    @default(A)
  deductionKg     Decimal      @default(0) @map("deduction_kg") @db.Decimal(10, 2)
  deductionNote   String?      @map("deduction_note") @db.VarChar(200)
  finalWeightKg   Decimal?     @map("final_weight_kg") @db.Decimal(10, 2)
  pricePerKg      Decimal      @map("price_per_kg") @db.Decimal(8, 2)
  feeAmount       Decimal      @default(0) @map("fee_amount") @db.Decimal(8, 2)
  totalAmount     Decimal?     @map("total_amount") @db.Decimal(12, 2)
  status          TicketStatus @default(draft)
  photoUrls       String[]     @map("photo_urls")
  note            String?
  createdBy       String?      @map("created_by") @db.VarChar(60)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  branchId        Int          @map("branch_id")
  paymentItem     PaymentItem?
  branch          Branch       @relation(fields: [branchId], references: [id])
  farmPlot        FarmPlot?    @relation(fields: [farmPlotId], references: [id])
  farmer          Farmer       @relation(fields: [farmerId], references: [id])
  price           DailyPrice   @relation(fields: [priceId], references: [id])
  vehicle         Vehicle?     @relation(fields: [vehicleId], references: [id])

  @@unique([companyId, ticketNo])
  @@index([companyId], map: "idx_tickets_company_id")
  @@index([farmerId], map: "idx_tickets_farmer_id")
  @@index([grade], map: "idx_tickets_grade")
  @@index([priceId], map: "idx_tickets_price_id")
  @@index([status], map: "idx_tickets_status")
  @@index([vehicleId], map: "idx_tickets_vehicle_id")
  @@index([branchId], map: "idx_tickets_branch_id")
  @@index([weighInAt(sort: Desc)], map: "idx_tickets_weigh_in_at")
  @@map("weigh_tickets")
}

model Payment {
  id          Int           @id @default(autoincrement())
  companyId   Int           @map("company_id")
  paymentRef  String        @map("payment_ref") @db.VarChar(30)
  farmerId    Int           @map("farmer_id")
  paymentDate DateTime      @default(now()) @map("payment_date") @db.Date
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod @default(bank_transfer)
  bankRef     String?       @map("bank_ref") @db.VarChar(60)
  status      PaymentStatus @default(pending)
  note        String?
  createdBy   String?       @map("created_by") @db.VarChar(60)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  branchId    Int           @map("branch_id")
  items       PaymentItem[]
  branch      Branch        @relation(fields: [branchId], references: [id])

  @@unique([companyId, paymentRef])
  @@index([companyId], map: "idx_payments_company_id")
  @@index([paymentDate(sort: Desc)], map: "idx_payments_date")
  @@index([farmerId], map: "idx_payments_farmer_id")
  @@index([status], map: "idx_payments_status")
  @@index([branchId], map: "idx_payments_branch_id")
  @@map("payments")
}

model PaymentItem {
  id        Int         @id @default(autoincrement())
  companyId Int         @map("company_id")
  paymentId Int         @map("payment_id")
  ticketId  Int         @unique @map("ticket_id")
  amount    Decimal     @db.Decimal(12, 2)
  payment   Payment     @relation(fields: [paymentId], references: [id])
  ticket    WeighTicket @relation(fields: [ticketId], references: [id])

  @@unique([companyId, ticketId])
  @@index([companyId], map: "idx_payment_items_company_id")
  @@index([paymentId], map: "idx_payment_items_payment")
  @@index([ticketId], map: "idx_payment_items_ticket")
  @@map("payment_items")
}

model Deduction {
  id               Int           @id @default(autoincrement())
  companyId        Int           @map("company_id")
  farmerId         Int           @map("farmer_id")
  deductionType    DeductionType @default(other) @map("deduction_type")
  description      String        @db.VarChar(200)
  amount           Decimal       @db.Decimal(12, 2)
  deductionDate    DateTime      @default(now()) @map("deduction_date") @db.Date
  isSettled        Boolean       @default(false) @map("is_settled")
  settledPaymentId Int?          @map("settled_payment_id")
  createdBy        String?       @map("created_by") @db.VarChar(60)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  branchId         Int           @map("branch_id")
  branch           Branch        @relation(fields: [branchId], references: [id])

  @@index([companyId], map: "idx_deductions_company_id")
  @@index([farmerId], map: "idx_deductions_farmer_id")
  @@index([isSettled], map: "idx_deductions_settled")
  @@index([branchId], map: "idx_deductions_branch_id")
  @@map("deductions")
}

model User {
  id           Int       @id @default(autoincrement())
  companyId    Int       @map("company_id")
  username     String    @db.VarChar(60)
  fullName     String    @map("full_name") @db.VarChar(100)
  email        String?   @db.VarChar(120)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         UserRole  @default(viewer)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  branchId     Int?      @map("branch_id")
  branch       Branch?   @relation(fields: [branchId], references: [id])
  company      Company   @relation(fields: [companyId], references: [id])

  @@unique([companyId, username])
  @@unique([companyId, email])
  @@index([companyId], map: "idx_users_company_id")
  @@map("users")
}

model Branch {
  id            Int           @id @default(autoincrement())
  companyId     Int           @map("company_id")
  branchCode    String        @map("branch_code") @db.VarChar(20)
  branchName    String        @map("branch_name") @db.VarChar(100)
  address       String?
  phone         String?       @db.VarChar(20)
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  company       Company       @relation(fields: [companyId], references: [id])
  prices        DailyPrice[]
  deductions    Deduction[]
  expenses      Expense[]
  payments      Payment[]
  sales         Sale[]        @relation("FromBranch")
  incomingSales Sale[]        @relation("ToBranch")
  stocks        Stock[]
  users         User[]
  weighTickets  WeighTicket[]

  @@unique([companyId, branchCode])
  @@index([companyId], map: "idx_branches_company_id")
  @@map("branches")
}

model Expense {
  id           Int      @id @default(autoincrement())
  companyId    Int      @map("company_id")
  expenseDate  DateTime @default(now()) @map("expense_date") @db.Date
  description  String   @db.VarChar(200)
  quantity     Decimal? @db.Decimal(12, 2)
  pricePerUnit Decimal? @map("price_per_unit") @db.Decimal(12, 2)
  amount       Decimal  @db.Decimal(12, 2)
  note         String?
  branchId     Int      @map("branch_id")
  productId    Int?     @map("product_id")
  createdBy    String?  @map("created_by") @db.VarChar(60)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  branch       Branch   @relation(fields: [branchId], references: [id])
  product      Product? @relation(fields: [productId], references: [id])

  @@index([companyId], map: "idx_expenses_company_id")
  @@index([expenseDate], map: "idx_expenses_date")
  @@index([branchId], map: "idx_expenses_branch_id")
  @@map("expenses")
}

model ProductGroup {
  id        Int       @id @default(autoincrement())
  companyId Int       @map("company_id")
  name      String    @db.VarChar(100)
  note      String?
  company   Company   @relation(fields: [companyId], references: [id])
  products  Product[]

  @@unique([companyId, name])
  @@index([companyId], map: "idx_product_groups_company_id")
  @@map("product_groups")
}

model Product {
  id        Int          @id @default(autoincrement())
  companyId Int          @map("company_id")
  name      String       @db.VarChar(100)
  groupId   Int          @map("group_id")
  unit      String?      @db.VarChar(20)
  expenses  Expense[]
  group     ProductGroup @relation(fields: [groupId], references: [id])

  @@unique([companyId, name, groupId])
  @@index([companyId], map: "idx_products_company_id")
  @@map("products")
}

model Stock {
  id         Int       @id @default(autoincrement())
  companyId  Int       @map("company_id")
  branchId   Int       @map("branch_id")
  grade      PalmGrade
  quantityKg Decimal   @default(0) @map("quantity_kg") @db.Decimal(12, 2)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  branch     Branch    @relation(fields: [branchId], references: [id])

  @@unique([companyId, branchId, grade])
  @@index([companyId], map: "idx_stocks_company_id")
  @@map("stocks")
}

model Customer {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company_id")
  name      String   @db.VarChar(100)
  phone     String?  @db.VarChar(20)
  address   String?
  note      String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  company   Company  @relation(fields: [companyId], references: [id])
  sales     Sale[]

  @@unique([companyId, name])
  @@index([companyId], map: "idx_customers_company_id")
  @@map("customers")
}

model Sale {
  id           Int        @id @default(autoincrement())
  companyId    Int        @map("company_id")
  saleNo       String     @map("sale_no") @db.VarChar(20)
  branchId     Int        @map("branch_id")
  customerId   Int?       @map("customer_id")
  customerName String?    @map("customer_name") @db.VarChar(100)
  saleDate     DateTime   @default(now()) @map("sale_date") @db.Timestamptz(6)
  grade        PalmGrade
  quantityKg   Decimal    @map("quantity_kg") @db.Decimal(12, 2)
  pricePerKg   Decimal    @map("price_per_kg") @db.Decimal(8, 2)
  totalAmount  Decimal?   @map("total_amount") @db.Decimal(12, 2)
  note         String?
  status       SaleStatus @default(completed)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  toBranchId   Int?       @map("to_branch_id")
  branch       Branch     @relation("FromBranch", fields: [branchId], references: [id])
  customer     Customer?  @relation(fields: [customerId], references: [id])
  toBranch     Branch?    @relation("ToBranch", fields: [toBranchId], references: [id])

  @@unique([companyId, saleNo])
  @@index([companyId], map: "idx_sales_company_id")
  @@index([branchId], map: "idx_sales_branch_id")
  @@index([saleDate], map: "idx_sales_date")
  @@index([customerId], map: "idx_sales_customer_id")
  @@map("sales")
}

model Log {
  id        Int      @id @default(autoincrement())
  companyId Int?     @map("company_id")
  userId    Int?     @map("user_id")
  action    String   @db.VarChar(100)
  details   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([companyId], map: "idx_logs_company_id")
  @@map("logs")
}

enum PalmGrade {
  A
  B
  C

  @@map("palm_grade")
}

enum TicketStatus {
  draft
  confirmed
  paid
  cancelled

  @@map("ticket_status")
}

enum PaymentMethod {
  bank_transfer
  cash
  cheque

  @@map("payment_method")
}

enum PaymentStatus {
  pending
  completed
  cancelled

  @@map("payment_status")
}

enum DeductionType {
  loan
  input_cost
  transport
  other

  @@map("deduction_type")
}

enum UserRole {
  admin
  weigher
  accountant
  viewer

  @@map("user_role")
}

enum SaleStatus {
  completed
  cancelled

  @@map("sale_status")
}
